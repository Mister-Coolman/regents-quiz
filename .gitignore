# DB backups
*.db.bak-*

# Generated by the explanation pipeline (scripts/) -- large, reproducible
/scripts/pdfs/
/scripts/rubric_cache/
/scripts/models/
/scripts/*.log
/scripts/*_review.html
/scripts/*_review.json
/scripts/transcripts_cache.json
/scripts/sample_explanations.json

# Review artifacts worth regenerating rather than versioning
/scripts/broken_crops.csv
/scripts/needs_review.csv

# Originals kept when recutting clipped crops
/scripts/recrop_backup/

# Question-number backfill outputs (regenerate with the two scripts)
/scripts/question_numbers_*.csv
/scripts/question_numbers_vlm_cache.json

# ELA pipeline output. The repo is public and most ELA passages are
# third-party copyrighted text: passages and the figures inside them must
# never be committed. (ELA question crops are NYSED material and may be.)
/scripts/ela_*/
/scripts/*passage*
!/scripts/check_no_passages.sh
*.stimuli.json
/backend/static/stimuli/
